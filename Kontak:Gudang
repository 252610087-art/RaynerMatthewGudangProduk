<div class="wrap">
    <div class="page-head">
        <h1>Contact us</h1>
        <p>Have questions about products, orders, or collaborations? Our team is happy to help.</p>
    </div>
    <hr class="rule">
    <div class="form-title">Send a message</div>
    <p class="form-sub">Fill out the form below, we will reply within 1x24 hours.</p>
    <form id="contactForm">
        <div class="field">
            <label for="nama">Name</label>
            <input type="text" id="nama" placeholder="Full Name">
        </div>
        <div class="field">
            <label for="email">E-mail</label>
            <input type="email" id="email" placeholder="name@email.com">
        </div>
        <div class="field">
                        <label for="pesan">Message</label>
                        <textarea id="pesan" placeholder="Write your message here."></textarea>
                    </div>
                    <button type="submit" class="btn-send">Send Message</button>
                    <div class="notice" id="successNotice">
                        <strong>Sent!</strong> Your message has reach the team and will be responded soon!
                    </div>
                </form>
            </div>
            <footer>
            <div class="container text-center">
  <script src="https://kit.fontawesome.com/597adb3636.js"
crossorigin="anonymous"></script>
 <a class="btn btn-primary" href="https://www.instagram.com"
role="button" target="_blank"><i class="fa-brands fa-instagram"></i></a>
 <a class="btn btn-primary" href="https://www.twitter.com"
role="button" target="_blank"><i class="fa-brands fa-x-twitter"></i></a>
<a class="btn btn-primary" href="https://www.facebook.com"
role="button" target="_blank"><i class="fa-brands fa-facebook"></i></a>
</div>
             
<script>
document.getElementById('contactForm').addEventListener('submit',
function(e){
e.preventDefault();
document.getElementById('successNotice').classList.add('show');
});
</script>
