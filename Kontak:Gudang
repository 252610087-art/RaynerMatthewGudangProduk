<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
:root{
--cream: #f8f6f2;
--cream-card: #F3ECDE;
--ink: #2B2620;
--ink-soft: #5A5347;
--rust: #B7472A;
--rust-dark: #8f3720;
--line: #E7DFCE;
}
* { box-sizing: border-box; }
body{
margin:0;
background: var(--cream);
color: var(--ink);
font-family: Georgia, 'Times New Roman', serif;
line-height: 1.55;
}
a { color: inherit; text-decoration: none; }
.wrap{
max-width: 560px;
margin: 0 auto;
padding: 0 24px;
}
/* Header */
.page-head{
padding: 40px 0 8px;
}
.page-head h1{
font-size: 2rem;
margin: 0 0 10px;
}
.page-head p{
color: var(--ink-soft);
font-size: 0.98rem;
max-width: 46ch;
margin: 0;
}
hr.rule{
border: none;
border-top: 1px solid var(--line);
margin: 32px 0;
}
/* Form section */
.form-title{
font-size: 1.3rem;
margin: 0 0 6px;
}
.form-sub{
color: var(--ink-soft);
font-size: 0.92rem;
margin: 0 0 22px;
}
.field{
margin-bottom: 18px;
}
.field label{
display:block;
font-size: 0.88rem;
color: var(--ink-soft);
margin-bottom: 6px;
font-family: -apple-system, Segoe UI, Roboto, sans-serif;
}
.field input,
.field textarea{
width: 100%;
border: 1px solid var(--line);
background: #fff;
border-radius: 8px;
padding: 11px 13px;
font-family: -apple-system, Segoe UI, Roboto, sans-serif;
font-size: 0.94rem;
color: var(--ink);
}
.field input:focus,
.field textarea:focus{
outline: none;
border-color: var(--rust);
box-shadow: 0 0 0 3px rgba(183,71,42,0.12);
}
.field textarea{ resize: vertical; min-height: 110px; }
.btn-send{
font-family: -apple-system, Segoe UI, Roboto, sans-serif;
background: var(--rust);
color: #fff;
border: none;
padding: 12px 26px;
border-radius: 8px;
font-size: 0.95rem;
cursor: pointer;
transition: background 0.15s ease;
}
.btn-send:hover{ background: var(--rust-dark); }
/* Success alert, styled like the "cara merawat" tip box */
.notice{
display:none;
background: var(--cream-card);
border-radius: 10px;
padding: 16px 18px;
font-family: -apple-system, Segoe UI, Roboto, sans-serif;
font-size: 0.9rem;
color: var(--ink);
margin-top: 18px;
}
.notice.show{ display:block; }
.notice strong{ color: var(--rust); }
footer{
border-top: 1px solid var(--line);
padding: 26px 0 34px;
text-align:center;
margin-top: 40px;
}
.socials{
display:flex;
justify-content:center;
gap: 14px;
margin-bottom: 14px;
}
.socials a{
width: 38px;
height: 38px;
border-radius: 50%;
background: var(--cream-card);
display:flex;
align-items:center;
justify-content:center;
color: var(--ink);
}
footer .copy{
font-size: 0.82rem;
color: var(--ink-soft);
font-family: -apple-system, Segoe UI, Roboto, sans-serif;
}
@media (max-width: 480px){
.contact-grid{ grid-template-columns: 1fr; }
.nav-links{ gap: 14px; font-size: 0.85rem; }
}
</style>

  </head>
